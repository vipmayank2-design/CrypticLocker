{
  "name": "CrypticLocker",
  "version": "1.0.0",
  "description": "A secure personal desktop vault for protecting private files and folders.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node test-all.js",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "build:win": "electron-builder --win --publish never",
    "build:portable": "electron-builder --win portable --publish never",
    "build:mac": "electron-builder --mac --publish never",
    "build:linux": "electron-builder --linux --publish never",
    "build:all": "electron-builder -mwl --publish never"
  },
  "keywords": [
    "encryption",
    "vault",
    "privacy",
    "security",
    "file-encryption",
    "aes-256",
    "electron",
    "desktop",
    "open-source",
    "offline-first"
  ],
  "author": "CrypticLocker Technologies",
  "license": "GPL-3.0",
  "homepage": "https://github.com/vipmayank2-design/CrypticLocker",
  "repository": {
    "type": "git",
    "url": "https://github.com/vipmayank2-design/CrypticLocker.git"
  },
  "bugs": {
    "url": "https://github.com/vipmayank2-design/CrypticLocker/issues"
  },
  "devDependencies": {
    "electron": "^40.8.0",
    "electron-builder": "^26.15.3",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1"
  },
  "build": {
    "publish": null,
    "appId": "com.crypticlocker.vault",
    "productName": "CrypticLocker",
    "copyright": "Copyright © 2026 CrypticLocker Technologies. Licensed under GPL-3.0.",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "core/**/*",
      "package.json",
      "!test-all.js",
      "!**/*.test.js"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CrypticLocker",
      "uninstallDisplayName": "CrypticLocker"
    },
    "fileAssociations": [
      {
        "ext": "clvault",
        "name": "CrypticLocker Vault Archive",
        "description": "CrypticLocker Encrypted Vault Backup",
        "icon": "build/icon.ico",
        "role": "Editor"
      },
      {
        "ext": "clpack",
        "name": "CrypticLocker Secure Capsule",
        "description": "CrypticLocker Secure Transfer Capsule",
        "icon": "build/icon.ico",
        "role": "Editor"
      }
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.security",
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "maintainer": "CrypticLocker Technologies <contact@crypticlocker.com>",
      "category": "Utility",
      "icon": "build/icon.png"
    }
  }
}
